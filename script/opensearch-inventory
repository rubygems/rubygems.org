#!/usr/bin/env bash

# Metadata only. Requires existing VPC access; never changes AWS or cluster state.
set +x # Credentials must not appear even when invoked with bash -x.
set -euo pipefail
umask 077

usage() {
  cat <<'EOF'
Usage: script/opensearch-inventory production|staging --output NEW_DIRECTORY
       [--profile read-only] [--snapshot-details]

Requires Bash, jq, AWS CLI v2 with configure export-credentials, and curl >= 7.75.
Run on an already authorized VPC-connected host with an authenticated AWS profile.
Permissions: sts:GetCallerIdentity, es:DescribeDomain, and es:ESHttpGet for the
domain's metadata APIs. A profile named read-only does not itself grant access.

Collects cluster health/settings, all visible index settings/mappings/aliases
(including hidden/closed indexes), shards, plugins, templates, pipelines and
snapshot repository/catalog metadata. No documents or search results are read.
By default snapshots use verbose=false; --snapshot-details also reads dates,
versions and failure details, which can be costly for large repositories.

Only fixed metadata GETs are sent to OpenSearch. No upgrade eligibility checks,
reindexing, snapshot verification/creation/restoration, or access changes.
TLS is verified; redirects, curl config files and HTTP proxies are not used.
Credentials go to curl over stdin, never arguments or inventory files.

Creates NEW_DIRECTORY (0700) with JSON files (0600) and manifest.json. Refuses
existing directories. Exit 0 means all requested reads succeeded; nonzero means
failure/incomplete inventory. Retains successful reads; records failed HTTP
statuses without saving error bodies. Review metadata before sharing it.
Successful reads do NOT prove index compatibility, correct results or recovery.
EOF
}

fail() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

environment=${1:-}
case "$environment" in
  -h|--help) usage; exit 0 ;;
  production) domain=rubygems-production-e1f0 ;;
  staging) domain=rubygems-staging-6881 ;;
  *) usage >&2; exit 1 ;;
esac
shift
profile=read-only
output=
snapshot_details=false
while (($#)); do
  case "$1" in
    --profile|--output)
      (($# >= 2)) && [[ -n "$2" ]] || fail "Missing value for $1"
      if [[ "$1" == --profile ]]; then profile=$2; else output=$2; fi
      shift 2 ;;
    --snapshot-details) snapshot_details=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *) fail "Unknown option: $1" ;;
  esac
done
[[ -n "$output" ]] || fail '--output NEW_DIRECTORY is required'
for tool in aws jq curl; do
  command -v "$tool" >/dev/null || fail "Missing dependency: $tool"
done
[[ $(curl -q --help all) == *--aws-sigv4* ]] || fail 'curl requires AWS SigV4 support (>= 7.75)'

mkdir -m 700 -- "$output" || fail 'Output must be a new directory with an existing parent'
output=$(cd -- "$output" && pwd -P)
started_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
endpoint=
failed=0
: > "$output/requests.jsonl"

finish() {
  local status=$?
  trap - EXIT
  unset credentials
  jq -n --arg domain "$domain" --arg endpoint "$endpoint" --arg profile "$profile" \
    --arg started_at "$started_at" --arg finished_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --argjson status "$status" --argjson snapshot_details "$snapshot_details" \
    --slurpfile requests "$output/requests.jsonl" \
    '{domain: $domain, region: "us-west-2", profile: $profile, endpoint: $endpoint,
      started_at: $started_at, finished_at: $finished_at, exit_status: $status,
      complete: ($status == 0), snapshot_details: $snapshot_details, requests: $requests,
      scope: "Metadata visible to this identity; not search correctness or restore proof"}' \
    > "$output/manifest.json"
  printf 'Inventory: %s (exit %s; inspect manifest.json)\n' "$output" "$status"
  exit "$status"
}
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

aws_read=(aws --profile "$profile" --region us-west-2 --no-cli-pager --no-cli-auto-prompt
  --cli-connect-timeout 5 --cli-read-timeout 30 --output json)
"${aws_read[@]}" sts get-caller-identity > "$output/identity.json"
jq -e '.Account == "048268392960"' "$output/identity.json" >/dev/null || fail 'Wrong AWS account'
"${aws_read[@]}" opensearch describe-domain --domain-name "$domain" > "$output/domain.json"
jq -e --arg arn "arn:aws:es:us-west-2:048268392960:domain/$domain" \
  '.DomainStatus.ARN == $arn and (.DomainStatus.VPCOptions.VPCId != null)' \
  "$output/domain.json" >/dev/null || fail 'Unexpected domain identity or non-VPC domain'
endpoint=$(jq -er '.DomainStatus.Endpoints.vpc // .DomainStatus.Endpoint' "$output/domain.json")
[[ "$endpoint" =~ ^vpc-${domain}-[a-z0-9]+\.us-west-2\.es\.amazonaws\.com$ ]] || fail 'Unexpected VPC endpoint hostname'

# AWS CLI resolves SSO credentials. Keep them in shell memory, not a temp file.
credentials=$("${aws_read[@]}" configure export-credentials --format process)
printf '%s' "$credentials" | jq -e \
  '(.AccessKeyId | type == "string" and length > 0) and
   (.SecretAccessKey | type == "string" and length > 0)' >/dev/null || fail 'No usable AWS credentials'

get_metadata() {
  local name=$1 path=$2 http_status transport_status=0 result=ok
  # -q MUST be first: ~/.curlrc must not add writes, tracing, redirects or -k.
  # Secret values are JSON-quoted for curl's config syntax and supplied on stdin.
  http_status=$(
    printf '%s' "$credentials" | jq -r '
      "user = " + ((.AccessKeyId + ":" + .SecretAccessKey) | @json),
      (if .SessionToken then "header = " + (("X-Amz-Security-Token: " + .SessionToken) | @json) else empty end)
    ' | curl -q --config - --silent --show-error --globoff --path-as-is \
      --proto '=https' --noproxy '*' --connect-timeout 5 --max-time 30 \
      --aws-sigv4 'aws:amz:us-west-2:es' --request GET \
      --url "https://$endpoint$path" --output "$output/$name.json" --write-out '%{http_code}'
  ) || transport_status=$?
  if ((transport_status != 0)); then
    result=transport_error
  elif [[ "$http_status" != 200 ]]; then
    result=http_error
  elif ! jq -e -s 'length == 1 and (.[0] | type == "object" or type == "array")' \
    "$output/$name.json" >/dev/null 2>&1; then
    result=invalid_json
  elif ! jq -e 'if type == "object" then
    .error == null and ((._nodes.failed // 0) == 0) and ((._shards.failed // 0) == 0)
    else true end' "$output/$name.json" >/dev/null; then
    result=partial_response
  fi
  jq -nc --arg name "$name" --arg path "$path" --arg http_status "$http_status" \
    --arg result "$result" --argjson transport_status "$transport_status" \
    '{name: $name, method: "GET", path: $path, http_status: $http_status,
      result: $result, transport_status: $transport_status}' >> "$output/requests.jsonl"
  printf '%s: %s (HTTP %s)\n' "$name" "$result" "$http_status"
  if [[ "$result" != ok ]]; then
    failed=1
    rm -f -- "$output/$name.json"
  fi
  ((transport_status == 0)) || fail 'Transport failed; check VPC routing, TLS and credentials before retrying into a new directory'
}

# Older curl SigV4 implementations require pre-sorted, URI-encoded query strings.
get_metadata server /
get_metadata health '/_cluster/health'
get_metadata cluster-settings '/_cluster/settings?flat_settings=true&include_defaults=true'
get_metadata index-settings '/_all/_settings?expand_wildcards=all&flat_settings=true&include_defaults=true'
get_metadata mappings '/_all/_mapping?expand_wildcards=all'
get_metadata aliases '/_all/_alias?expand_wildcards=all'
get_metadata indices '/_cat/indices?bytes=b&expand_wildcards=all&format=json&h=health%2Cstatus%2Cindex%2Cuuid%2Cpri%2Crep%2Cdocs.count%2Cstore.size'
get_metadata shards '/_cat/shards?bytes=b&format=json&h=index%2Cshard%2Cprirep%2Cstate%2Cdocs%2Cstore%2Cnode%2Cunassigned.reason'
get_metadata plugins '/_nodes/plugins'
get_metadata legacy-templates '/_template'
get_metadata index-templates '/_index_template'
get_metadata component-templates '/_component_template'
get_metadata ingest-pipelines '/_ingest/pipeline'
get_metadata pending-tasks '/_cluster/pending_tasks'
get_metadata repositories '/_snapshot/_all'

if [[ -f "$output/repositories.json" ]]; then
  # Numeric file names avoid treating repository names as filesystem paths.
  repository_number=0
  while IFS= read -r repository; do
    repository_number=$((repository_number + 1))
    get_metadata "snapshots-$repository_number" \
      "/_snapshot/$repository/_all?verbose=$snapshot_details"
  done < <(jq -r 'keys[] | @uri' "$output/repositories.json")
fi

exit "$failed"
