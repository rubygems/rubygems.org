#!/bin/sh

##############################################################################
# This script will download the most recently weekly dump listed on
# https://rubygems.org/pages/data and load it into a postgresql database.
#
# Assumptions:
#
# 1) the user you pass with the -u option is a postgres super user
#
# Notes:
#
#  * This script will drop and create the database, so buyer beware.
#
##############################################################################

# variables
public_tar=
pg_database=rubygems
pg_user=postgres
download=false
host=
port=

## For downloading
base_url="https://s3-us-west-2.amazonaws.com/rubygems-dumps/"
prefix="production/public_postgresql"

## Usage info
show_help() {
  cat << EOF
Usage: ${0##*/} [-h] [-c] [-d DATABASE] [-u USER] FILE

Load a rubygems.org postgresql dump into a database.

    -h          display this help and exit
    -c          download the latest file to FILE
    -d DATABASE load the data into this database (default: rubygems)
    -u USER     connect to postgresql using this username (default: postgres)
    -H HOSTNAME connect to postgresql using this hostname (default: Unix-domain socket)
    -p PORT     connect to postgresql using this port (default: 5432)

Examples:
Load already downloaded tar: ./load-pg-dump -d rubygems_development ~/Downloads/public_postgresql.tar
Download and then load most recent dump: ./load-pg-dump -d rubygems_development -c ~/Downloads/public_postgresql.tar
EOF
}

OPTIND=1
while getopts "hcd:u:H:p:" opt; do
    case "$opt" in
        h)
            show_help
            exit 0
            ;;
        c)  download=true
            ;;
        d)  pg_database=$OPTARG
            ;;
        u)  pg_user=$OPTARG
            ;;
        H)  host=$OPTARG
            ;;
        p)  port=$OPTARG
            ;;
        '?')
            show_help >&2
            exit 1
            ;;
    esac
done
shift "$((OPTIND-1))" # Shift off the options and optional

pg_host=
if [ -n "$host" ]; then
  pg_host="-h $host"
fi
if [ -n "$port" ]; then
  pg_host="${pg_host} -p $port"
fi

public_tar=$1
if [ -z "$public_tar" ]; then
  show_help >&2
  exit 1
fi

if $download; then
  key=$(curl -s "${base_url}?prefix=${prefix}" | sed -ne 's/.*<Key>\(.*\)<\/Key>.*/\1/p')
  latest_url="${base_url}${key}"
  echo "Downloading ${latest_url} to ${public_tar}"
  curl --progress-bar "${latest_url}" > ${public_tar}
fi

printf 'Loading "%s" into database "%s" as user "%s"\n', "$public_tar", "$pg_database", "$pg_user"

echo "Dropping database $pg_database"
dropdb $pg_host -U $pg_user $pg_database

echo "Creating database $pg_database"
createdb $pg_host -U $pg_user $pg_database

echo "Adding hstore extension"
psql -q $pg_host -U $pg_user -d $pg_database -c "CREATE EXTENSION IF NOT EXISTS hstore;"

echo "Running migrations"
rake db:migrate

# Extract the single PostgresSQL.sql.gz file from the tar file, pass it through gunzip
# and load only its data, as quietly as possible, into the tables the migrations
# created. The dump's own DDL is skipped: it clashes with the migrated tables,
# assigns ownership to production roles, and adds foreign keys to tables that
# aren't in the public dump.
#
# Foreign key checks are disabled while loading (this needs a superuser), since
# the dump's COPY blocks aren't in dependency order.
echo "Loading the data from $public_tar"
tar xOf "$public_tar" public_postgresql/databases/PostgreSQL.sql.gz | \
  gunzip -c | \
  awk '
    copying { print; if ($0 == "\\.") copying = 0; next }
    /^COPY / { print; copying = 1; next }
    /^(SET (statement_timeout|client_encoding|standard_conforming_strings) |SELECT pg_catalog\.(set_config|setval)\(|\\(un)?restrict )/ { print }
  ' | \
  PGOPTIONS="-c session_replication_role=replica" \
  psql -q -o /dev/null -v ON_ERROR_STOP=1 $pg_host --username $pg_user --dbname $pg_database || exit 1

# The public dump doesn't include organizations or API keys, so clear references
# to them to keep the foreign keys valid.
echo "Clearing references to data that isn't in the public dump"
psql -q -v ON_ERROR_STOP=1 $pg_host -U $pg_user -d $pg_database <<SQL || exit 1
UPDATE rubygems SET organization_id = NULL
  WHERE organization_id IS NOT NULL
  AND NOT EXISTS (SELECT 1 FROM organizations WHERE organizations.id = rubygems.organization_id);
UPDATE versions SET pusher_api_key_id = NULL
  WHERE pusher_api_key_id IS NOT NULL
  AND NOT EXISTS (SELECT 1 FROM api_keys WHERE api_keys.id = versions.pusher_api_key_id);
SQL

echo "Done."
