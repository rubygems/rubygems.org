<div class="ml-3 flex text-neutral-900 dark:text-white hover:text-black dark:hover:text-neutral-400 items-center" data-controller="dialog">
  <% if signed_in? %>
    <%= button_tag type: :button, class: "h-9 w-9 rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange", aria: { label: t('layouts.application.header.account_menu'), haspopup: "dialog" }, data: { action: "dialog#open", dialog_target: "button", testid: "header-popup-link" } do %>
      <%= avatar 64, "user_gravatar", theme: :dark, class: "h-9 w-9 rounded" %>
    <% end %>
  <% else %>
    <div class="hidden md:flex text-nowrap">
      <%= render ButtonComponent.new t('sign_in'), sign_in_path, type: :link, color: :secondary, size: :small %>
      <%= render ButtonComponent.new t('sign_up'), sign_up_path, type: :link, color: :primary, size: :small, class: "ml-3" %>
    </div>

    <%= link_to sign_up_path, aria: { label: t('sign_up') }, class: "-mr-1 p-1 md:hidden text-neutral-800 dark:text-white hover:text-neutral-600 dark:hover:text-neutral-400 " do %>
      <%= icon_tag "account-box", size: 7 %>
    <% end %>
  <% end %>

  <dialog
    data-dialog-target="dialog" data-action="click->dialog#backdropClose cancel->dialog#close"
    aria-label="<%= t('layouts.application.header.account_menu') %>"
    class="account-menu fixed m-0 inset-0 py-16 px-8 z-50 w-full h-full max-w-screen max-h-screen bg-white bg-opacity-20 p-0 ems-start justify-center sm:justify-right"
  >
    <div class="max-w-screen-xl mx-auto flex items-center relative">
      <!-- Dialog content -->
      <div
        class="w-full sm:absolute sm:top-0 sm:right-0 sm:max-w-xs bg-white dark:bg-black rounded-lg shadow-xl shadow-black/10 max-h-[calc(100dvh-8rem)] overflow-y-auto dark:border dark:border-neutral-800
        flex flex-col px-4 py-4 text-b2 text-left text-neutral-900 dark:text-white"
      >
        <!-- Account identity -->
        <div class="flex items-start justify-between gap-2 pl-3 pb-4">
          <div class="min-w-0 py-1">
            <p class="text-b3 text-neutral-600 dark:text-neutral-400"><%= t('layouts.application.header.signed_in_as') %></p>
            <p class="font-semibold break-words"><%= current_user&.display_handle %></p>
          </div>
          <button data-action="dialog#close" aria-label="<%= t('layouts.application.header.close_account_menu') %>" class="flex h-11 w-11 shrink-0 items-center justify-center rounded hover:bg-neutral-100 dark:hover:bg-neutral-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange">
            <%= icon_tag "close", class: "w-6 h-6", aria: { hidden: true } %>
          </button>
        </div>

        <!-- Authenticated user content -->
        <nav class="flex flex-col pb-2 border-b border-neutral-400 dark:border-neutral-800">
          <%= link_to t('layouts.application.header.profile'), dashboard_path, class: "px-3 py-3 rounded hover:bg-neutral-100 dark:hover:bg-neutral-800" %>
          <%= link_to t('layouts.application.header.edit_profile'), edit_profile_path, class: "px-3 py-3 rounded hover:bg-neutral-100 dark:hover:bg-neutral-800" %>
          <%= link_to t('layouts.application.header.settings'), edit_settings_path, class: "px-3 py-3 rounded hover:bg-neutral-100 dark:hover:bg-neutral-800" %>
        </nav>
        <%= button_to t('sign_out'), sign_out_path, method: :delete, form_class: "mt-2", class: "w-full text-left px-3 py-3 rounded hover:bg-neutral-100 dark:hover:bg-neutral-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange" if signed_in? %>
      </div>
    </div>
  </dialog>
</div>
