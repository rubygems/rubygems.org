<% subgrid_class = "@xl:grid @xl:grid-cols-subgrid" %>
<% badge_class = "inline-flex w-fit items-center rounded-full px-2 py-1 @xl:py-0 text-b4 font-semibold no-underline bg-neutral-200 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 hover:bg-neutral-300 dark:hover:bg-neutral-700" %>
<% muted_text_class = "text-b4 text-neutral-700 dark:text-neutral-400" %>

<div class="@container">
  <ol data-testid="gem-versions" class="flex flex-col @xl:grid @xl:grid-cols-[repeat(3,max-content)_minmax(0,1fr)_repeat(2,max-content)] @xl:gap-x-4">
    <% versions.to_a.group_by(&:number).each_value do |version_group| %>
      <li class="flex flex-col gap-y-1 py-1.5 border-t border-neutral-200 dark:border-neutral-800 first:border-t-0 @xl:col-span-full <%= subgrid_class %>">
        <div class="text-c4">
          <span class="font-mono px-1.5 rounded-sm bg-green-200 dark:bg-green-800 text-neutral-900 dark:text-white"><%= version_group.first.number %></span>
        </div>

        <ol class="flex flex-col gap-y-1 @xl:gap-y-0.5 @xl:col-span-5 <%= subgrid_class %>">
          <% version_group.group_by(&:platform).each do |platform, platform_versions| %>
            <li class="flex flex-col @xl:col-span-full <%= subgrid_class %>">
              <% unless platform == "ruby" %>
                <p class="text-b4 text-neutral-900 dark:text-white @xl:col-start-2 @xl:row-start-1"><%= platform %></p>
              <% end %>

              <ol class="flex flex-col gap-y-1 @xl:gap-y-0.5 @xl:col-span-full @xl:col-start-1 @xl:row-start-1 <%= subgrid_class %>">
                <% platform_versions.each do |version| %>
                  <% advisory_warning = version_advisory_warning(@advisories, version) %>
                  <li class="flex flex-wrap items-center gap-x-3 gap-y-1 @xl:col-span-full @xl:gap-x-4 @xl:gap-y-0 <%= subgrid_class %>">
                    <%= link_to rubygem_version_path(version.rubygem.slug, version.slug), class: badge_class do %>
                      <span class="sr-only"><%= version.display_id %></span>
                      <% if version.ruby_abi.present? %>
                        <%= t "versions.version.ruby_abi" %> <%= version.ruby_abi %>
                      <% elsif version.platformed? %>
                        <%= t "versions.version.multi_abi" %>
                      <% else %>
                        <%= t "versions.version.source_gem" %>
                      <% end %>
                    <% end %>
                    <span class="<%= muted_text_class %> ml-auto whitespace-nowrap @xl:ml-0 @xl:col-start-4 @xl:row-start-1"><%= version_date_tag(version) %></span>
                    <span class="<%= muted_text_class %> whitespace-nowrap tabular-nums text-right @xl:col-start-5 @xl:row-start-1"><%= number_to_human_size(version.size) %></span>
                    <% if version.ruby_abi.present? || version.yanked? || advisory_warning %>
                      <span class="flex min-w-0 items-center gap-2 @xl:col-span-full @xl:row-start-2 @3xl:col-span-1 @3xl:col-start-3 @3xl:row-start-1">
                        <% if version.ruby_abi.present? %>
                          <span class="<%= muted_text_class %> truncate" title="<%= version.content_address %>">
                            <% if version.content_address.present? %>
                              <%= t "versions.version.content_address" %>: <%= version.content_address %>
                            <% else %>
                              <%= t "versions.version.no_content_address" %>
                            <% end %>
                          </span>
                        <% end %>
                        <% if version.yanked? %>
                          <span class="text-b4 font-semibold text-red-600 dark:text-red-400"><%= t "versions.version.yanked" %></span>
                        <% end %>
                        <% if advisory_warning %>
                          <span class="flex" data-testid="version-vulnerability">
                            <%= render TooltipComponent.new(
                              text: advisory_warning[:label],
                              placement: :right,
                              trigger_class: "#{advisory_warning[:class]} align-middle",
                              trigger_label: advisory_warning[:label],
                              href: rubygem_version_path(version.rubygem.slug, version.slug, anchor: "advisories")
                            ) do %>
                              <%= icon_tag advisory_warning[:icon], size: 5, aria: { hidden: "true" } %>
                            <% end %>
                          </span>
                        <% end %>
                      </span>
                    <% end %>
                  </li>
                <% end %>
              </ol>
            </li>
          <% end %>
        </ol>
      </li>
    <% end %>
  </ol>
</div>
