<% @title = t(".title", username: @user.display_id) %>

<% content_for :subject do %>
  <%= render "profiles/subject", user: @user %>
<% end %>

<!-- Main Content -->
<h1 class="text-h2 mb-10"><%= t(".title", username: @user.display_handle) %></h1>

<%= render CardComponent.new do |c| %>
  <%= c.head do %>
    <%= c.title t(".gems"), icon: "gems", count: @user.total_rubygems_count %>
  <% end %>

  <% items = rubygems_with_history_for(@rubygems, prior_rubygems_of(@user)) %>
  <% if items.empty? %>
    <%= prose do %>
      <i><%= t(".no_gems") %></i>
    <% end %>
  <% else %>
    <%= c.divided_list do %>
      <% items.each do |rubygem, removed_at| %>
        <% if removed_at %>
          <%= render "profiles/prior_rubygem", c: c, rubygem: rubygem, removed_at: removed_at %>
        <% else %>
          <%= render "profiles/current_rubygem", c: c, rubygem: rubygem %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
