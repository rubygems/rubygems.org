<% version = rubygem.most_recent_version %>
<%= c.list_item_to(
  rubygem_path(rubygem.slug),
  title: short_info(version),
  class: "text-neutral-500 dark:text-neutral-500"
) do %>
  <div class="flex flex-col w-full justify-between">
    <div class="flex flex-row w-full items-center justify-between">
      <h4 class="text-b1 flex"><%= rubygem.name %></h4>
      <span data-testid="rubygem-version"><%= version_number(version) %></span>
    </div>
    <div class="flex flex-row w-full items-center justify-between">
      <%= download_count_component(rubygem, class: "flex", data: { testid: "rubygem-downloads" }) %>
      <div class="flex text-neutral-400 dark:text-neutral-600" data-testid="rubygem-removed-at">
        <%= t("profiles.show.prior_rubygem_removed_at", removed_at: nice_date_for(removed_at), published_at: nice_date_for(version.authored_at)) %>
      </div>
    </div>
  </div>
<% end %>
